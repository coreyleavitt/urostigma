<Project Sdk="Microsoft.NET.Sdk">

	<!--
	RFC-010 slice 4 fixture: an IDnsApplicationApiHandler implementor whose
	behavior is driven entirely by the incoming DnsAppApiRequest.Path, not by
	static test-control state, because DnsApplication loads this assembly into
	a fresh collectible AssemblyLoadContext per construction, so a static field
	set from the test project would not be visible to the loaded type. See
	ScriptedHandlerApp for the path vocabulary. Published via
	ScriptedApiHandlerAppFixture (FixtureAppPublisher), not built as part of
	the solution/DnsServerApp build.
	-->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Nullable>enable</Nullable>
		<AssemblyName>RfcApiHandler.Scripted</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\DnsServerCore.ApplicationCommon\DnsServerCore.ApplicationCommon.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="TechnitiumLibrary.Net">
			<HintPath>..\..\..\..\..\TechnitiumLibrary\bin\TechnitiumLibrary.Net.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>
